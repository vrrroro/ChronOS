# ==============================================================================
# ChronOS - Adaptive CPU Scheduling Engine
# Sample environment configuration
# ------------------------------------------------------------------------------
# Copy this file to `.env` and edit the values you care about:
#     cp .env.example .env
#
# NOTE ON SECRETS: there are none. ChronOS is a single-user local tool with no
# backend, no database, no accounts and no external APIs (PRD Section 3.2), so
# nothing here is sensitive. This file exists to centralize the many values the
# PRD/EDRD explicitly mark "EDIT ME" - AARS weights, classification thresholds,
# quanta, palette - so you can retune them without recompiling or hunting
# through source. Committing `.env` is harmless, but gitignore it anyway so your
# personal tuning doesn't fight with the defaults checked into the repo.
#
# Section references (PRD x.y / EDRD x.y) point at where each value came from.
# Values marked [GUESS] are not specified in either document - I picked a
# sensible starting number so the key isn't empty; change freely.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. PATHS & PROJECT LAYOUT                                          (PRD 4.2)
# ------------------------------------------------------------------------------
# All paths are relative to the repo root unless absolute.

CHRONOS_ROOT=.
ENGINE_DIR=engine
DASHBOARD_DIR=dashboard
ANALYSIS_DIR=analysis
WORKLOADS_DIR=workloads
RESULTS_DIR=results
LOGS_DIR=logs


# ------------------------------------------------------------------------------
# 2. BUILD                                                           (PRD 4.3)
# ------------------------------------------------------------------------------
# C++17, standard library only, CMake, nlohmann/json as a single header.

CMAKE_BUILD_TYPE=Debug
# Debug | Release | RelWithDebInfo - use Release for the benchmark stretch goal
CXX_STANDARD=17
CXX_COMPILER=g++
BUILD_DIR=build
CHRONOS_BINARY=chronos
# On Windows the built binary will be chronos.exe; leave the name extensionless.

# Path to the single-header nlohmann/json drop-in. Download json.hpp once and
# point this at it.
NLOHMANN_JSON_HEADER=engine/vendor/json.hpp


# ------------------------------------------------------------------------------
# 3. SIMULATION DEFAULTS                                    (PRD 4.1, 5.1, 5.2)
# ------------------------------------------------------------------------------
# What the binary uses when a CLI flag isn't supplied.

DEFAULT_ALGORITHM=AARS
# FCFS | SJF | RR | PRIORITY | MLFQ | AARS
DEFAULT_WORKLOAD=mixed
# cpu_heavy | interactive | mixed | starvation  (files in WORKLOADS_DIR)

DEFAULT_QUANTUM=4
# Fallback quantum when the workload JSON doesn't specify one (PRD 5.2).

# Priority convention: 1 (low) .. 10 (high) - PRD 5.1
PRIORITY_MIN=1
PRIORITY_MAX=10

# Deterministic tie-breaking so tests are reproducible (PRD 6.1; Tests 7 and 8).
TIE_BREAK_RULE=LOWEST_PID
# LOWEST_PID | EARLIEST_ARRIVAL | SHORTEST_BURST

# Safety valve: abort the tick loop past this many ticks, so a scheduler bug
# that never terminates fails loudly instead of hanging. [GUESS]
MAX_TICKS=100000

# Cost in ticks charged per context switch. The PRD counts switches but doesn't
# charge for them; keep 0 to match the documented metrics, raise it only if you
# deliberately want to model switch overhead. [GUESS]
CONTEXT_SWITCH_COST=0

# Random workload generation (PRD 7.7: "set a number of random processes").
RANDOM_SEED=42
RANDOM_PROCESS_COUNT=10
RANDOM_ARRIVAL_MAX=30
RANDOM_BURST_MIN=1
RANDOM_BURST_MAX=20


# ------------------------------------------------------------------------------
# 4. AARS SCORING WEIGHTS                                            (PRD 6.2)
# ------------------------------------------------------------------------------
# Score = BasePriority + AgingBonus + IOBonus + ResponseBonus - BurstPenalty
#
# These are THE numbers the PRD tells you to retune in Milestone 2 against real
# burst distributions. Keep a note of what you changed and why - that's the
# "research contribution" narrative (PRD Section 9, Milestone 2 item 3).

# Aging Bonus = min(waitingTime / DIVISOR, CAP)  - this is what prevents starvation
AARS_AGING_DIVISOR=2
AARS_AGING_CAP=10

# I/O Bonus, by predicted class
AARS_BONUS_IO_BOUND=4
AARS_BONUS_INTERACTIVE=2
AARS_BONUS_CPU_BOUND=0
AARS_BONUS_UNKNOWN=0

# Response Bonus - one-time boost for a process that has never run
# (responseTime == -1). This is what buys "interactive feel".
AARS_RESPONSE_BONUS=3

# CPU Burst Penalty = min(avgBurstHistory / DIVISOR, CAP)
AARS_BURST_PENALTY_DIVISOR=5
AARS_BURST_PENALTY_CAP=8

# Preemption (PRD Milestone 3, item 3): a new arrival may preempt the running
# process if it scores at least this much higher. Leave disabled for AARS v1.
AARS_PREEMPTION_ENABLED=false
AARS_PREEMPT_SCORE_MARGIN=2.0
# [GUESS] - "a much higher score" is unquantified in the PRD. Too low and you
# thrash context switches; too high and preemption never fires. Watch the
# context-switch count in the comparison table while tuning this.


# ------------------------------------------------------------------------------
# 5. BEHAVIOR CLASSIFICATION (rule-based, no ML)                     (PRD 6.3)
# ------------------------------------------------------------------------------
# Recomputed after each completed burst. Also explicitly marked "EDIT ME" -
# look at your actual burst-length distributions before trusting these.

CLASSIFY_HISTORY_WINDOW=5
# Keep the last N burst lengths per process; avgBurst = mean of these.

CLASSIFY_CPU_BOUND_MIN_AVG_BURST=15
# avgBurst > this  ->  CPU_BOUND

CLASSIFY_IO_BOUND_MAX_AVG_BURST=4
# avgBurst < this AND ioEvents > CLASSIFY_IO_MIN_EVENTS  ->  IO_BOUND
CLASSIFY_IO_MIN_EVENTS=0

CLASSIFY_INTERACTIVE_MAX_AVG_BURST=4
# avgBurst < this AND historically low response time  ->  INTERACTIVE

CLASSIFY_MIN_BURSTS_OBSERVED=2
# Stay UNKNOWN until this many bursts are seen - new processes start neutral,
# which is intentionally fair.


# ------------------------------------------------------------------------------
# 6. DYNAMIC TIME QUANTUM (AARS)                                     (PRD 6.4)
# ------------------------------------------------------------------------------
# Used when AARS preempts on a quantum boundary, Round-Robin style.

QUANTUM_CPU_BOUND=8
QUANTUM_UNKNOWN=5
QUANTUM_INTERACTIVE=3
QUANTUM_IO_BOUND=2


# ------------------------------------------------------------------------------
# 7. CLASSIC ALGORITHM PARAMETERS                     (PRD Milestones 1 and 3)
# ------------------------------------------------------------------------------

# --- Round Robin ---
RR_QUANTUM=4

# --- Priority scheduling with basic aging (Milestone 1, item 5) ---
# "+STEP priority per INTERVAL ticks waited" - simpler than the AARS formula.
PRIORITY_AGING_STEP=1
PRIORITY_AGING_INTERVAL=5
# [GUESS] - the PRD says "+1 per N ticks" without fixing N.
PRIORITY_AGING_CAP=10
# Don't let an aged process climb past PRIORITY_MAX. [GUESS]
PRIORITY_PREEMPTIVE=false

# --- MLFQ (Milestone 3 - leave as-is until you get there) ---
MLFQ_QUEUE_COUNT=3
MLFQ_QUANTA=4,8,16
# Comma-separated, highest-priority queue first. Needs QUEUE_COUNT entries.
MLFQ_BOOST_INTERVAL=50
# Periodic full priority-boost: every N ticks move everything back to queue 0.
# The PRD recommends this over a cleverer promotion rule. [GUESS on N]
MLFQ_DEMOTE_ON_QUANTUM_EXHAUSTION=true


# ------------------------------------------------------------------------------
# 8. OUTPUT & LOGGING                                          (PRD 5.3, 11)
# ------------------------------------------------------------------------------
# The result JSON is the ONLY contract between the engine and the dashboard.

RESULT_FILE=results/results.json
# Filename pattern for comparison runs. Placeholders: {algorithm} {workload}
RESULT_FILE_PATTERN=results/{workload}_{algorithm}.json
RESULT_JSON_PRETTY=true
RESULT_JSON_INDENT=2
# Pretty-printing makes the JSON far easier to eyeball while debugging.

# One decision log, two views (PRD 11): human-readable text + structured JSON.
LOG_FILE=logs/scheduler.log
LOG_LEVEL=info
# debug | info | warn | error
LOG_APPEND=false
# false = truncate each run, so the log always matches the latest run.
LOG_DECISION_LOG=true
# Embed the structured decisionLog array in the result JSON. The why-panel
# (PRD 7.4) is driven by this - turning it off breaks the best demo feature.
LOG_CANDIDATE_SCORES=true
# Log every candidate's score per decision, not just the winner. Verbose, but
# this is your viva answer key for "why did it do that at tick 14?"


# ------------------------------------------------------------------------------
# 9. DASHBOARD                                          (PRD 7 / EDRD 5, 6)
# ------------------------------------------------------------------------------
# Static HTML/CSS/JS opened straight from disk - no build step, no server.
# Plain browser JS cannot read a .env file, so mirror anything the dashboard
# needs into a small dashboard/config.js (hand-written, or generated by
# analysis.py from these keys so there's still one source of truth).

DASHBOARD_RESULTS_FILE=results/results.json
DASHBOARD_AUTOPLAY=false
DASHBOARD_DEFAULT_SPEED=1
DASHBOARD_SPEED_STEPS=0.5,1,2,4
# Discrete segmented control, not a free slider (EDRD 5.6).
DASHBOARD_TICKS_PER_SECOND=4
# Playback rate at 1x. [GUESS] - tune until a demo run reads as "live" rather
# than either sluggish or too fast to narrate over.

# Aging warning flash threshold (EDRD 5.5 - explicitly "configurable, e.g. 8").
DASHBOARD_AGING_WARNING_THRESHOLD=8

# Gantt chart rendering (EDRD 5.2)
GANTT_TRACK_HEIGHT_PX=120
GANTT_LABEL_MIN_SEGMENT_WIDTH_PX=32
# Narrower segments drop their PID label and reveal it on hover instead.
GANTT_SEGMENT_OPACITY=0.85
GANTT_SHOW_IDLE_HATCHING=true
# Render CPU-idle gaps as diagonal hatching, not ambiguous blank space.

# Ready queue table (EDRD 5.3)
READY_QUEUE_SHOW_SCORE_COLUMN=auto
# auto = shown only for AARS runs, hidden entirely otherwise (never shown empty).
READY_QUEUE_MAX_VISIBLE_ROWS=12
# [GUESS] - beyond this the table scrolls with sticky headers.

# Motion (EDRD 6). REDUCE_MOTION=true disables the pulse, flash and load-in
# animations - useful if a projector renders them badly during the viva.
REDUCE_MOTION=false
TRANSITION_FAST_MS=100
TRANSITION_BASE_MS=180
TRANSITION_SLOW_MS=300


# ------------------------------------------------------------------------------
# 10. ANALYSIS & CHARTS                              (PRD 8.2 / EDRD 7.2)
# ------------------------------------------------------------------------------
# analysis.py reads result JSONs and emits the comparison table plus charts.
# Python can read this file directly (python-dotenv), so these keys are live
# config rather than documentation.

ANALYSIS_INPUT_DIR=results
ANALYSIS_OUTPUT_DIR=analysis/output
ANALYSIS_TABLE_FORMATS=markdown,csv

COMPARISON_ALGORITHMS=FCFS,SJF,RR,PRIORITY,MLFQ,AARS
COMPARISON_WORKLOADS=cpu_heavy,interactive,mixed,starvation
COMPARISON_METRICS=avgWaitingTime,avgTurnaroundTime,avgResponseTime,contextSwitches,cpuUtilization,throughput

CHART_FORMAT=png
CHART_DPI=150
CHART_WIDTH_IN=10
CHART_HEIGHT_IN=6
MPLSTYLE_PATH=analysis/chronos.mplstyle
# The EDRD suggests generating this style file early so every chart matches the
# dashboard without re-styling each one by hand.

CHART_FONT_FAMILY=JetBrains Mono
CHART_FONT_PATH=analysis/fonts/JetBrainsMono-Regular.ttf
# Matplotlib can load a .ttf directly - this is what keeps the charts visually
# continuous with the dashboard during a presentation.

# Chart chrome, matching the dashboard palette (EDRD 7.2)
CHART_BG=#000000
CHART_AXES_BG=#0A0F0A
CHART_TEXT_COLOR=#39FF14
CHART_GRID_COLOR=#1A3D1A

# One fixed color per ALGORITHM (not per process), held constant across every
# chart in the report - so "AARS is always cyan" throughout.
# Deliberately not emphasizing AARS: per PRD 2.4 the charts must not editorialize.
ALGO_COLOR_FCFS=#8FE68F
ALGO_COLOR_SJF=#FFB300
ALGO_COLOR_RR=#FF3EC9
ALGO_COLOR_PRIORITY=#3E9EFF
ALGO_COLOR_MLFQ=#B15CFF
ALGO_COLOR_AARS=#0FF0FC


# ------------------------------------------------------------------------------
# 11. THEME TOKENS (reference copy)                              (EDRD 2, 8.1)
# ------------------------------------------------------------------------------
# The authoritative home for these is the :root block in dashboard/style.css.
# They are duplicated here ONLY so analysis.py can generate a matching
# .mplstyle from one place. If you change a color, change it in both - or
# better, have analysis.py emit style.css's :root block too and keep this copy
# as the single source.

THEME_BG_VOID=#000000
THEME_BG_PANEL=#0A0F0A
THEME_BG_PANEL_RAISED=#0F1A0F
THEME_BG_INSET=#050805
THEME_BORDER_DEFAULT=#1A3D1A
THEME_BORDER_ACTIVE=#39FF14
THEME_TEXT_PRIMARY=#39FF14
THEME_TEXT_SECONDARY=#8FE68F
THEME_TEXT_DIM=#3D5C3D
THEME_TEXT_ON_ACCENT=#000000
# EDRD 2.1 alternatives if #39FF14 is too intense on your projector:
# #00FF41 (cooler, Matrix-leaning) or #4AF626 (marginally softer).

# Process state colors (EDRD 2.2)
THEME_STATE_RUNNING=#39FF14
THEME_STATE_READY=#8FE68F
THEME_STATE_WAITING=#FFD23F
THEME_STATE_TERMINATED=#3D5C3D
THEME_STATE_NEW=#1A3D1A

# Semantic accents (EDRD 2.5)
THEME_ACCENT_POSITIVE=#39FF14
THEME_ACCENT_NEGATIVE=#FF3E5C
THEME_ACCENT_WARNING=#FFD23F
THEME_ACCENT_INFO=#0FF0FC

# Per-process palette, cycled as palette[pid % length] (EDRD 2.3)
THEME_PROC_PALETTE=#39FF14,#0FF0FC,#FF3EC9,#FFB300,#3E9EFF,#FF5C33,#B15CFF,#D4FF3E


# ------------------------------------------------------------------------------
# 12. OPTIONAL LOCAL SERVER                     (PRD 7.7 / EDRD 6.8) - STRETCH
# ------------------------------------------------------------------------------
# Milestone 4 only. Lets the dashboard's RUN button actually invoke the C++
# binary instead of you running it in a terminal. Not an MVP requirement -
# leave this disabled until everything else works.

LOCAL_SERVER_ENABLED=false
LOCAL_SERVER_HOST=127.0.0.1
LOCAL_SERVER_PORT=8000
LOCAL_SERVER_ALLOW_RUN=false
# Gates executing the binary from an HTTP request. Keep the host bound to
# 127.0.0.1 - this endpoint launches a local process and must never be exposed
# on a network.


# ------------------------------------------------------------------------------
# 13. STRETCH GOALS                                                  (PRD 6.5)
# ------------------------------------------------------------------------------
# Pick at most ONE of these if Milestones 1-3 finish early.

THREADS_MODE_ENABLED=false
# Real pthreads/mutexes reimplementation of the tick loop. Keep the
# JSON-producing path as primary so a threading bug can't take down the demo.
THREADS_COUNT=4

BENCHMARK_MODE_ENABLED=false
BENCHMARK_PROCESS_COUNT=1000
# The PRD frames 1,000-5,000 as an appendix, not a core feature.

FAIRNESS_INDEX_ENABLED=false
# Jain's fairness index over CPU-time-received vs. CPU-time-needed. Cheapest of
# the three to add once per-process stats already exist.


# ------------------------------------------------------------------------------
# 14. TESTING                                                        (PRD 10)
# ------------------------------------------------------------------------------

TEST_LARGE_PROCESS_COUNT=300
# Test case 9: performance sanity check (the PRD suggests 200-500).
TEST_FIXTURES_DIR=tests/fixtures
TEST_STRICT_DETERMINISM=true
# Fail a test if two identical runs differ - catches accidental reliance on
# container iteration order or uninitialized state.
